# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ─────────────────────────────────────────────────────────────────
IMAP_HOST=imap.example.com
IMAP_USER=you@example.com
IMAP_PASSWORD=your_imap_password_or_app_password

# ── IMAP (optional) ──────────────────────────────────────────────────────────
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_INBOX=INBOX

# Folder names vary by provider:
#   iCloud Mail  → "Junk"
#   Gmail        → "[Gmail]/Spam"
#   Fastmail     → "Spam"
IMAP_JUNK_FOLDER=Junk
IMAP_POTENTIAL_SPAM_FOLDER=Potential Spam

# ── Ollama (optional) ────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
# Other good options: mistral:7b, phi3:mini (low RAM), llama3.2:3b
OLLAMA_MODEL=llama3.1:8b

# ── Classification thresholds (optional) ─────────────────────────────────────
# >= SPAM_CONFIDENCE_THRESHOLD  → move to Junk
# >= POTENTIAL_SPAM_THRESHOLD   → move to Potential Spam
# below both                    → leave in INBOX
SPAM_CONFIDENCE_THRESHOLD=0.85
POTENTIAL_SPAM_THRESHOLD=0.60

# How long to wait (seconds) in IMAP IDLE before re-polling
POLL_INTERVAL=300
